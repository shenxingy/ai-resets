[Unit]
Description=AI Reset Watch email subscription API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__AI_RESETS_USER__
Group=__AI_RESETS_GROUP__
WorkingDirectory=__AI_RESETS_REPO__
LoadCredentialEncrypted=RESEND_API_KEY
LoadCredentialEncrypted=SUBSCRIPTION_SECRET
LoadCredentialEncrypted=RESEND_WEBHOOK_SECRET
# The sending identity. Required now that no address is compiled in, so a
# deployment can never mail as somebody else's domain. Optional-loaded (`-`)
# so a missing file does not stop the unit; the script then says what is absent.
EnvironmentFile=-/etc/ai-resets/service.env
ExecStart=/usr/bin/python3 __AI_RESETS_REPO__/scripts/subscriptions.py serve
Restart=on-failure
RestartSec=3
StateDirectory=ai-resets
StateDirectoryMode=0700
UMask=0077

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
