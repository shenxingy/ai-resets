# Local-development alternative to systemd's encrypted credentials.
#
# On a real host the secrets below live in the credential store and the rest
# come from /etc/ai-resets/service.env; this file exists so the API can be run
# from a shell without any of that. Never commit a filled-in copy.
#
#   set -a; . infra/subscription.env; set +a
#   python3 scripts/subscriptions.py serve

# Secrets. On a host these are LoadCredentialEncrypted, not variables.
RESEND_API_KEY=re_replace_me
SUBSCRIPTION_SECRET=replace_with_at_least_32_random_characters
RESEND_WEBHOOK_SECRET=whsec_replace_me

# The sending identity. Required; there is no built-in default, so that a
# deployment can never mail as a domain it does not control.
RESEND_FROM_EMAIL="AI Reset Watch <updates@example.com>"

# Optional. Defaults to public_url in site.config.json.
#PUBLIC_BASE_URL=https://resets.example.com

# Paths. Relative to wherever this checkout is; the defaults below are what
# the systemd units use.
SUBSCRIPTION_DB=/var/lib/ai-resets/subscribers.db
AI_RESETS_STATE=/var/lib/ai-resets
#AI_RESETS_DATA=./site/data.json

SUBSCRIPTION_HOST=127.0.0.1
SUBSCRIPTION_PORT=8787

# Where operational alerts go. Empty keeps them in the journal only.
OWNER_EMAIL=
