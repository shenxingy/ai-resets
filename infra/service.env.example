# Install as /etc/ai-resets/service.env (root-owned; 0644 is fine, nothing in
# here is a secret — the Resend key and the signing secret stay in systemd's
# encrypted credential store).
#
#   sudo install -d /etc/ai-resets
#   sudo install -m 0644 infra/service.env.example /etc/ai-resets/service.env
#   sudo $EDITOR /etc/ai-resets/service.env
#   sudo systemctl daemon-reload
#
# Loaded by the subscribe, notify and alert units: every unit that can send
# mail, and no others.

# The From address on every message this deployment sends. REQUIRED — there is
# no compiled-in default, so that a deployment can never mail as somebody
# else's domain. Use an address on a domain you have verified with your own
# mail provider; anything else is rejected at send time.
RESEND_FROM_EMAIL="AI Reset Watch <updates@example.com>"

# Optional. The links inside outgoing mail. Defaults to public_url in
# site.config.json, which is also what the built pages use, so set this only
# when the mail should point somewhere the site does not.
#PUBLIC_BASE_URL=https://resets.example.com
