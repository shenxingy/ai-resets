# Install as /etc/ai-resets/publish.env (root-owned, 0640 or tighter if it ever
# holds anything sensitive). Sourced by infra/publish.sh when readable, so the
# cron line stays a single command.
#
#   sudo install -m 0640 infra/publish.env.example /etc/ai-resets/publish.env
#   sudo $EDITOR /etc/ai-resets/publish.env
#
# This is the cron-side counterpart to /etc/ai-resets/service.env, which only
# the systemd units read.

# Your own PostHog project key. Unset means analytics is off and build.py
# writes an inert analytics.js — that is the default and it is a fine place to
# stay. A key belongs here rather than in the repository because a key in a
# public repository is one that anyone can post events into.
#AI_RESETS_POSTHOG_KEY=phc_your_own_project_key

# Where the built site is written. Usually set on the cron line instead.
#AI_RESETS_DEPLOY_TARGET=/srv/ai-resets
