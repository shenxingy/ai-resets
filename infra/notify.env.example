# Install as /etc/ai-resets/notify.env (root-owned, 0644 is fine: no
# secrets belong in this file — the Resend key and signing secret stay in
# systemd's encrypted credential store).
#
#   sudo install -d /etc/ai-resets
#   sudo install -m 0644 infra/notify.env.example /etc/ai-resets/notify.env
#   sudo $EDITOR /etc/ai-resets/notify.env   # set OWNER_EMAIL
#   sudo systemctl daemon-reload

# Where operational alerts go. Not a subscriber address; it never receives
# announcement mail. Leave empty to keep alerts in the journal only.
OWNER_EMAIL=
